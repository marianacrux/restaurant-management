# Copie este archivo como .env y complete los valores. NUNCA suba .env a GitHub.
NODE_ENV=development
PORT=4000

# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://restaurant_app:CAMBIAR_CONTRASENA@localhost:5432/restaurant_db?schema=public"

# Genere uno con: openssl rand -hex 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Contraseña común de los usuarios de prueba creados por el seed (solo desarrollo)
SEED_USER_PASSWORD=CAMBIAR_CONTRASENA_DEMO
