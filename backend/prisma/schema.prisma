// =====================================================================
//  Sistema de gestión de pedidos - Modelo de datos (BORRADOR v0.1)
//  Estado: pendiente de aprobación. Aún NO se ha ejecutado ninguna migración.
//  Convenciones:
//   - IDs enteros autoincrementales (legibles en el demo y en Postman).
//   - Dinero en Decimal(12,2): nunca Float (evita errores de redondeo).
//   - Productos y domiciliarios se desactivan (soft delete), no se borran.
//   - OrderItem guarda nombre y precio del producto al momento del pedido.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- ENUMS ---------------------------------

enum Role {
  ADMIN
  CAJERO
  COCINA
  DOMICILIARIO
  CLIENTE // reservado: los clientes del demo no inician sesión (ver Customer)
}

/// Canal por el que LLEGÓ el pedido.
enum OrderSource {
  WHATSAPP
  VITRINA
  PUNTO_DE_VENTA
  DOMICILIO // pedido telefónico/externo para entregar en dirección
}

/// Cómo se ENTREGA el pedido (independiente del canal).
enum OrderType {
  EN_LOCAL
  PARA_LLEVAR
  DOMICILIO
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  NEQUI
  DAVIPLATA
  TARJETA
  CONTRAENTREGA_EFECTIVO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  REEMBOLSADO
}

enum TransportType {
  A_PIE
  BICICLETA
  MOTOCICLETA
}

enum DeliveryPersonStatus {
  DISPONIBLE
  OCUPADO
  INACTIVO
}

enum DeliveryStatus {
  ASIGNADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DiscountType {
  PORCENTAJE
  VALOR_FIJO
}

enum ScreenContentType {
  PRODUCTO
  PROMOCION
  ANUNCIO
}

enum ChatChannel {
  SIMULADOR
  WHATSAPP_CLOUD
}

// --------------------------- USUARIOS --------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveryPerson   DeliveryPerson? // si el usuario es domiciliario
  ordersCreated    Order[]              @relation("OrderCreatedBy")
  paymentsRecorded Payment[]
  statusChanges    OrderStatusHistory[]

  @@index([role, active])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique // clave natural: WhatsApp identifica por teléfono
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// ---------------------------- CATÁLOGO -------------------------------

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  position    Int      @default(0) // orden de aparición en menús y pantallas
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  available   Boolean  @default(true) // false = AGOTADO hoy
  active      Boolean  @default(true) // false = retirado del catálogo (soft delete)
  isDailyMenu Boolean  @default(false) // aparece en el menú del día
  isFeatured  Boolean  @default(false) // destacado (pantalla 4)
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  promotions     Promotion[]
  screenContents ScreenContent[]

  @@index([categoryId])
  @@index([active, available])
}

model Promotion {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  discountType  DiscountType @default(PORCENTAJE)
  discountValue Decimal      @db.Decimal(12, 2)
  imageUrl      String?
  productId     Int? // promoción ligada a un producto/combo (opcional)
  startDate     DateTime
  endDate       DateTime
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  screenContents ScreenContent[]

  @@index([active, startDate, endDate])
}

// ----------------------------- PEDIDOS -------------------------------

model Order {
  id              Int            @id @default(autoincrement())
  orderNumber     Int            @unique @default(autoincrement()) // número visible ("pedido 105")
  source          OrderSource
  type            OrderType      @default(EN_LOCAL)
  status          OrderStatus    @default(PENDIENTE)
  customerId      Int? // null = cliente de mostrador sin datos
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod? // método que el cliente ELIGIÓ (no implica pago)
  paymentStatus   PaymentStatus  @default(PENDIENTE) // derivado de los Payment registrados
  deliveryAddress String?
  notes           String?
  cancelReason    String?
  createdById     Int? // null = creado por el bot de WhatsApp
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  delivery      Delivery?
  statusHistory OrderStatusHistory[]
  chatSession   ChatSession?

  @@index([status])
  @@index([source])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int? // SetNull: borrar un producto nunca borra el historial
  productName String // copia histórica
  unitPrice   Decimal @db.Decimal(12, 2) // copia histórica
  quantity    Int
  notes       String? // "sin cebolla", "término medio"...
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id             Int          @id @default(autoincrement())
  orderId        Int
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedById    Int? // null = sistema/bot
  note           String?
  createdAt      DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ------------------------------ PAGOS --------------------------------

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int
  method       PaymentMethod
  status       PaymentStatus @default(PAGADO)
  amount       Decimal       @db.Decimal(12, 2)
  reference    String? // nº de transacción Nequi/Daviplata/transferencia
  notes        String?
  recordedById Int
  createdAt    DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User  @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([method, createdAt])
}

// --------------------------- DOMICILIOS ------------------------------

model DeliveryPerson {
  id            Int                  @id @default(autoincrement())
  name          String
  phone         String               @unique
  transportType TransportType
  availability  DeliveryPersonStatus @default(DISPONIBLE)
  active        Boolean              @default(true) // false = ya no trabaja (soft delete)
  userId        Int?                 @unique // cuenta para iniciar sesión
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([availability, active])
}

model Delivery {
  id               Int            @id @default(autoincrement())
  orderId          Int            @unique // una entrega vigente por pedido
  deliveryPersonId Int
  status           DeliveryStatus @default(ASIGNADO)
  assignedAt       DateTime       @default(now())
  pickedUpAt       DateTime?
  deliveredAt      DateTime?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Restrict)

  @@index([deliveryPersonId, status])
}

// ------------------------ PANTALLAS DIGITALES ------------------------

model MenuScreen {
  id           Int      @id @default(autoincrement())
  screenNumber Int      @unique // 1..4
  name         String
  description  String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  contents ScreenContent[]
}

model ScreenContent {
  id          Int               @id @default(autoincrement())
  screenId    Int
  contentType ScreenContentType
  title       String?
  description String?
  imageUrl    String?
  productId   Int? // si contentType = PRODUCTO (precio/disponibilidad se leen en vivo)
  promotionId Int? // si contentType = PROMOCION
  position    Int               @default(0)
  active      Boolean           @default(true)

  screen    MenuScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([screenId, position])
}

// ------------------------ WHATSAPP / CHATBOT -------------------------

/// Estado de una conversación del bot. El mismo motor sirve al simulador
/// y, más adelante, al webhook de WhatsApp Cloud API.
model ChatSession {
  id        String      @id @default(uuid())
  channel   ChatChannel @default(SIMULADOR)
  phone     String?
  step      String      @default("INICIO") // paso actual de la máquina de estados
  data      Json        @default("{}") // carrito y datos capturados
  orderId   Int?        @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([phone, updatedAt])
}

// --------------------------- CONFIGURACIÓN ---------------------------

/// Parámetros editables por el administrador (p. ej. DELIVERY_FEE).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
